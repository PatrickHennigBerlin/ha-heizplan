          "name": "Off from",
          "description": "Date DD.MM when the season is switched off"
        },
        "weather_entity": {
          "name": "Weather",
          "description": "Weather entity with daily forecast"
        },
        "on_below": {
          "name": "On below",
          "description": "On when all days are below this value"
